# ── Hatch — profile.yaml template ───────────────────────────────────────────
# Copy this file to data/profile.yaml and fill in your details.
# Or run `./install.sh` — it creates the profile automatically and detects
# your Ollama model so you can start immediately without any API key.
#
# NEVER commit data/profile.yaml — it contains personal information.
# It is listed in .gitignore by default.

# ─── Locale ──────────────────────────────────────────────────────────────────
# Controls job boards, currency, and compliance fields.
# Supported: uk | in | ie | ae
locale: "uk"

# ─── Identity ────────────────────────────────────────────────────────────────
candidate:
  name: ""                          # Full name (used in CV/cover letter generation)
  title: ""                         # Current or target professional title
  years_experience: 0               # Total years of professional experience
  summary: ""                       # 2-3 sentence professional summary

# ─── Search Parameters ───────────────────────────────────────────────────────
search:
  target_roles:                     # Job titles to search for (list)
    - ""                            # e.g. "Delivery Lead", "Senior SWE", "Product Manager"
  locations:
    - city: ""                      # e.g. "London", "Pune", "Dublin"
      country: ""                   # ISO country code: GB, IN, IE, AE
      radius_miles: 30
      remote_preference: "any"      # "onsite" | "hybrid" | "remote" | "any"
  contract_type: "any"              # "contract" | "permanent" | "freelance" | "any"

# ─── Compensation ────────────────────────────────────────────────────────────
compensation:
  min_rate: 0
  max_rate: 0
  rate_type: "daily"                # "daily" | "hourly" | "annual" | "monthly"
  currency: ""                      # Set by locale — GBP, INR, EUR, AED, etc.
  legal_preferences: {}             # Locale-specific fields set by onboarding wizard

# ─── Skills & Experience ─────────────────────────────────────────────────────
skills:
  primary:                          # Core skills — weighted highest in scoring
    - ""
  secondary:                        # Supporting skills
    - ""
  certifications:
    - ""

domains:
  preferred:                        # Industries / domains you want to work in
    - ""
  excluded:                         # Domains to filter out entirely
    - ""

# ─── Proof Points ────────────────────────────────────────────────────────────
# Key achievements mapped into tailored CVs and cover letters.
proof_points:
  - id: "achievement_1"
    summary: ""                     # One-line achievement
    context: ""                     # Company / project context
    metrics: ""                     # Quantified result
    tags: []

# ─── Master CV ───────────────────────────────────────────────────────────────
master_cv_path: "./data/master_cv.json"

# ─── Job Boards ──────────────────────────────────────────────────────────────
# The install script populates this from your locale pack automatically.
# Add/remove boards here or toggle via Settings → Job Boards in the UI.
job_boards: []

# ─── Scoring ─────────────────────────────────────────────────────────────────
scoring:
  weights:
    skill_match: 0.35
    experience_match: 0.30
    rate_match: 0.20
    location_match: 0.15
  shortlist_threshold: 0.75         # Jobs above this score get auto-tailored
  method: "auto"                    # "auto" | "llm" | "local" | "hybrid"

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Default: Ollama (local, free, no API key).
# The install script detects your installed Ollama model automatically.
# To use a cloud provider, change provider and set the API key in .env.
llm:
  provider: "ollama"                # "ollama" | "anthropic" | "openai" | "google_genai" | "azure_openai"
  triage_model: ""                  # Populated by install.sh from local Ollama models
  primary_model: ""                 # Populated by install.sh from local Ollama models
  base_url: "http://host.containers.internal:11434"  # Ollama endpoint (container → host)
  api_key_env: ""                   # Env var name for cloud providers (e.g. ANTHROPIC_API_KEY)
  temperature: 0.3
  max_retries: 3
  track_costs: false
  monthly_budget: 0.0
  currency: ""                      # Set per locale

# ─── Preferences ─────────────────────────────────────────────────────────────
preferences:
  scrape_interval_hours: 4
  max_tailor_batch: 5
  follow_up_days: [5, 10, 15]
  archive_after_days: 30
