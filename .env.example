# Hatch environment configuration
# Copy to .env. Local llama.cpp is the default and needs no API key.

DATABASE_URL=sqlite+aiosqlite:///./data/jobpilot.db
LOG_LEVEL=INFO
SCRAPE_INTERVAL_HOURS=4
SCORE_THRESHOLD=0.75
MAX_TAILOR_BATCH=5
PLAYWRIGHT_HEADLESS=true

# Local app lock (privacy-by-default). Set false only for explicit test/demo use.
HATCH_APP_LOCK_ENABLED=true
# Optional admin-controlled password; when empty, first-run setup stores a bcrypt hash.
HATCH_APP_PASSWORD=
HATCH_APP_SESSION_TTL_HOURS=12
HATCH_APP_LOCK_FAILED_ATTEMPT_LIMIT=5
HATCH_APP_LOCK_RETRY_DELAY_SECONDS=30

# Optional cloud LLM providers. Uncomment only the provider you use.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# AZURE_OPENAI_API_KEY=...
FIRECRAWL_ENABLED=false
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_SECONDS=20
FIRECRAWL_MAX_PAGES_PER_IMPORT=1
