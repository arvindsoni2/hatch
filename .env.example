# ╔══════════════════════════════════════════════════════════╗
# ║           JobPilot — Environment Configuration          ║
# ╠══════════════════════════════════════════════════════════╣
# ║  Copy this file to .env and fill in your values         ║
# ║  cp .env.example .env                                   ║
# ╚══════════════════════════════════════════════════════════╝

# ──────────── Required ────────────
DATABASE_URL=sqlite+aiosqlite:///./data/jobpilot.db
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ──────────── Scraper Config ────────────
SCRAPE_INTERVAL_HOURS=4
SCRAPE_DELAY_MIN_SECONDS=2
SCRAPE_DELAY_MAX_SECONDS=8
PLAYWRIGHT_HEADLESS=true

# Priority keywords for notifications (comma-separated)
PRIORITY_KEYWORDS=solutions architect,cloud architect,enterprise architect,data architect,delivery manager,product owner,technical lead

# Minimum daily rate for priority alerts (GBP)
PRIORITY_MIN_RATE=500

# ──────────── API Keys (Optional — scrapers skip if not set) ────────────
# Reed: Free at https://www.reed.co.uk/developers
REED_API_KEY=

# Adzuna: Free at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ──────────── Frontend ────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ──────────── Logging ────────────
LOG_LEVEL=INFO

# ──────────── Notifications ────────────
NOTIFICATION_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ──────────── v2 Scraper (Broader Search) ────────────
SCRAPE_LOOKBACK_DAYS=90
QUICK_SCRAPE_HOURS=48
FULL_SCRAPE_INTERVAL_HOURS=8
QUICK_SCRAPE_INTERVAL_HOURS=3
MAX_PAGES_PER_KEYWORD=20

# ──────────── AI Classifier ────────────
CLASSIFIER_BATCH_SIZE=30
CLASSIFIER_RUN_INTERVAL_MINUTES=30
MATCH_SCORE_MIN_FOR_DIGEST=70
MATCH_SCORE_MIN_FOR_AUTO_APPLY=60

# ──────────── Auto-Apply ────────────
AUTO_APPLY_ENABLED=true
AUTO_APPLY_MAX_PER_HOUR=10
AUTO_APPLY_COOLDOWN_SECONDS=30
AUTO_APPLY_ENABLED_BOARDS=reed,cwjobs
REED_EMAIL=
REED_PASSWORD=
CWJOBS_EMAIL=
CWJOBS_PASSWORD=

# ──────────── Daily Digest ────────────
DIGEST_ENABLED=true
DIGEST_TIME=07:00
DIGEST_TIMEZONE=Europe/London
DIGEST_FREQUENCY=daily

# ──────────── Optional Integrations ────────────
# SerpAPI: https://serpapi.com (used for company research in Coach module)
SERPAPI_KEY=
