# Hatch environment configuration
# Copy to .env. Local llama.cpp is the default and needs no API key.

DATABASE_URL=sqlite+aiosqlite:///./data/jobpilot.db
LOG_LEVEL=INFO
SCRAPE_INTERVAL_HOURS=4
SCORE_THRESHOLD=0.75
MAX_TAILOR_BATCH=5
PLAYWRIGHT_HEADLESS=true

# Optional cloud LLM providers. Uncomment only the provider you use.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# AZURE_OPENAI_API_KEY=...
